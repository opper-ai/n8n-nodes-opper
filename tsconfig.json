{
	"compilerOptions": {
		"strict": true,
		"module": "commonjs",
		"moduleResolution": "node",
		"target": "es2021",
		"lib": ["es2021", "dom"],
		"esModuleInterop": true,
		"skipLibCheck": true,
		"declaration": true,
		"sourceMap": false,
		"outDir": "./dist",
		"removeComments": true,
		"useUnknownInCatchVariables": false,
		"forceConsistentCasingInFileNames": true,
		"noUnusedLocals": true,
		"resolveJsonModule": true
	},
	"include": ["credentials/**/*", "nodes/**/*", "package.json"]
}
